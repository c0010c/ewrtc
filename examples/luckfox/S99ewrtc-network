#!/bin/sh
# The USB gadget exists after S50usbdevice; do not depend on dr_mode text matching.
case "${1:-}" in
start|restart)
    if test -r /etc/default/ewrtc-network; then
        . /etc/default/ewrtc-network
    fi
    : "${EWRTC_USB_ADDRESS:?Set EWRTC_USB_ADDRESS in /etc/default/ewrtc-network}"
    for attempt in 1 2 3 4 5; do
        test -d /sys/class/net/usb0 && break
        sleep 1
    done
    test -d /sys/class/net/usb0 || exit 1
    # A factory camera may have spawned a USB DHCP client; leave eth0 DHCP alone.
    for entry in /proc/[0-9]*/cmdline; do
        test -r "$entry" || continue
        command_line=$(tr '\000' ' ' <"$entry" 2>/dev/null) || continue
        case "$command_line" in
            'udhcpc -i usb0 '*|'/sbin/udhcpc -i usb0 '*|'/usr/sbin/udhcpc -i usb0 '*)
                process_dir=${entry%/cmdline}
                kill "${process_dir##*/}" 2>/dev/null || true
                ;;
        esac
    done
    ip addr replace "$EWRTC_USB_ADDRESS" dev usb0
    ip link set usb0 up
    ;;
stop) ;;
*) echo "Usage: $0 {start|stop|restart}" >&2; exit 2 ;;
esac
