# Copy to .env.luckfox at the repository root, edit, then source it.
export EWRTC_DEVICE_HOST="root@YOUR_DEVICE_IP"
export EWRTC_DEVICE_PROGRAM="ewrtc_camera"
export EWRTC_DEVICE_DIR="/userdata/ewrtc"
# Optional; otherwise use your SSH agent or default identity:
# export EWRTC_SSH_KEY="$HOME/.ssh/your_device_key"
