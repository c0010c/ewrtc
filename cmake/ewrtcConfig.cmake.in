@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
set(ewrtc_AVAILABLE_COMPONENTS "@public_components@")
if(@export_linux@ OR (@export_session@ AND @EWRTC_WITH_LIBJUICE@))
  find_dependency(Threads)
endif()
if(@export_session@)
  if(@EWRTC_WITH_OPENSSL@)
    find_dependency(OpenSSL 3.0 COMPONENTS Crypto SSL)
  endif()
  find_dependency(PkgConfig)
  if(@EWRTC_WITH_MBEDTLS@)
    pkg_check_modules(MBEDCRYPTO REQUIRED IMPORTED_TARGET mbedcrypto>=3.6)
    pkg_check_modules(MBEDTLS REQUIRED IMPORTED_TARGET mbedtls)
    pkg_check_modules(MBEDX509 REQUIRED IMPORTED_TARGET mbedx509)
  endif()
  pkg_check_modules(SRTP REQUIRED IMPORTED_TARGET libsrtp2>=2.5)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/ewrtcTargets.cmake")
foreach(component IN LISTS ewrtc_FIND_COMPONENTS)
  if(component IN_LIST ewrtc_AVAILABLE_COMPONENTS)
    set(ewrtc_${component}_FOUND TRUE)
  else()
    set(ewrtc_${component}_FOUND FALSE)
  endif()
endforeach()
check_required_components(ewrtc)
